---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import CallToAction from "@/components/sections/CallToAction.astro";
import LayoutWrapper from "@/components/LayoutWrapper.astro";
import fetchApi from "@/lib/utils/fetchApi";
import type { StrapiResponse, CaseStudy, Category } from "@/types";
import resolveImageUrl from "@/lib/utils/resolveImageUrl";

export async function getStaticPaths() {
  const { data } = await fetchApi<StrapiResponse<Category[]>>({ endpoint: "categories" });
  const paths = data.map((cat) => ({
    params: { category: cat.slug },
    props: { category: { name: cat.name, slug: cat.slug } },
  }));
  return paths;
}

const { category } = Astro.props;

const { data } = await fetchApi<StrapiResponse<CaseStudy[]>>({
  endpoint: "case-studies",
  query: {
    "populate[coverImage][populate]": true,
    "populate[categories]": true,
    "populate[author][populate]": "avatar",
    populate: "categories",
    sort: "publishedAt:desc",
  },
});

const caseStudies = data.map((caseStudy) => ({
  data: {
    title: caseStudy.title,
    date: new Date(caseStudy.publishedAt).toLocaleDateString(Astro.currentLocale),
    image: resolveImageUrl(caseStudy.coverImage),
    categories: caseStudy.categories?.map((cat) => cat.name) || [],
    content: caseStudy.content,
    author: caseStudy.author?.name || "",
  },
  slug: caseStudy.slug,
  id: caseStudy.id,
}));
const title = `${category.name}`;
---

<Base title={title}>
  <PageHeader hiddenPaths={["Category"]} title={category.name} />
  <LayoutWrapper
    pageType="list"
    sidebar={{
      enable: true,
      sticky: true,
      position: "right",
    }}
    contentList={{
      items: caseStudies,
      options: { content: "case-studies", layout: "grid", gap: "gap-8", columns: 2 },
      filter: { category: category },
    }}
  />
  <CallToAction />
</Base>
