---
import Base from "@/layouts/Base.astro";
import fetchApi from "@/lib/utils/fetchApi";
import parseTomlToJson from "@/lib/utils/parseTomlToJson";
import BlogListPage from "@/components/CaseStudyListPage.astro";
import type { CaseStudy, Post } from "@/types";

export async function getStaticPaths() {
  const config = parseTomlToJson("./src/config/config.toml");
  const caseStudies = await fetchApi<Post[]>({ endpoint: "case-studies", wrappedByKey: "data" });
  const paginationSize = config.settings.pagination || 6;
  const totalPages = Math.ceil(caseStudies.length / paginationSize);
  const paths = [];
  for (let i = 1; i <= totalPages; i++) {
    paths.push({ params: { slug: i.toString() } });
  }
  return paths;
}

const { slug } = Astro.params;
const currentPage = slug && !isNaN(Number(slug)) ? Number(slug) : 1;

---

<Base title="Case Studies" fitToScreen={false}>
  <BlogListPage currentPage={currentPage} />
</Base>
