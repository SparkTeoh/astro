---
import fetchApi from "@/lib/utils/fetchApi";
import type { PostListItem, StrapiResponse, Post } from "@/types";
import LayoutWrapper from "@/components/LayoutWrapper.astro";
import CallToAction from "@/components/sections/CallToAction.astro";
import parseTomlToJson from "@/lib/utils/parseTomlToJson";
import resolveImageUrl from "@/lib/utils/resolveImageUrl";
import PageHeader from "@/components/widgets/PageHeader.astro";


const config = parseTomlToJson("./src/config/config.toml");

const { currentPage } = Astro.props;

let caseStudies:PostListItem[] = [];
let totalPages = 1;

try {
  const pageSize = config.settings.pagination || 6;
  const page = currentPage || 1;

  const { data, meta } = await fetchApi<StrapiResponse<Post[]>>({
    endpoint: "case-studies",
    query: {
      "populate[coverImage][populate]": true,
      "pagination[page]": String(page),
      "pagination[pageSize]": String(pageSize),
      "populate": "categories",
      "sort": "publishedAt:desc",
    },
  });
 
  caseStudies = data.map((item) => ({
    data: {
      title: item.title,
      date: new Date(item.publishedAt).toLocaleDateString(Astro.currentLocale),
      image: resolveImageUrl(item.coverImage),
      categories: item.categories?.map((cat) => cat.name) || [],
      content: item.content,
      author: item.author?.name || "",
    },
    slug: item.slug,
    id: item.id,
  }));
  totalPages = meta?.pagination?.pageCount ?? 1;
} catch (error) {
  console.error("Case Study fetch error:", error);
  caseStudies = [];
}


console.log('CASE STUDIES PASSED TO CONTENTLIST:', JSON.stringify(caseStudies, null, 2));
---

<PageHeader />
<LayoutWrapper
  pageType="list"
  sidebar={{ enable: true, sticky: true, position: "right" }}
  contentList={{
    items :caseStudies,
    options: { content: "case-study", layout: "grid", gap: "gap-8", columns: 2 },
    pagination: { enable: true, currentPage, totalPages },
  }}
/>
<CallToAction />
