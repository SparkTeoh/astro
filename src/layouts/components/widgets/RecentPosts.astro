---
// DISABLED: This component uses Strapi API which has been removed
// TODO: Convert to use local Markdown files for recent posts

import BlogCard from "../cards/BlogCard.astro";
import { useTranslations } from "@/lib/utils/languageParser";

interface Props {
  class?: string;
}

// Mock data for now
const data = [];
---

<!-- DISABLED: Recent posts functionality -->
<div class="{Astro.props.class}">
  <p>Recent posts functionality disabled. TODO: Implement local MD file support.</p>
</div>
  },
});

const posts = data.map((post) => ({
  title: post.title,
  slug: post.slug,
  collection: "blog",
  date: new Date(post.publishedAt).toISOString(),
  image: resolveImageUrl(post.coverImage),
  categories: post.categories?.map((cat) => cat.name) || [],
})).slice(0, 3);

const t = await useTranslations(Astro.currentLocale as string);
---

{
  posts && posts.length > 0 && (
    <div class="space-y-4">
      <h2 class="text-h5 border-border-default/50 mb-4 border-b pb-4">
        {t("widgets.recent_posts_title")}
      </h2>
      <div class="space-y-3">
        {posts.map((post) => (
          <BlogCard
            content={{ ...post, slug: post.slug }}
            options={{ card: { layout: "horizontal" } }}
          />
        ))}
      </div>
    </div>
  )
}
