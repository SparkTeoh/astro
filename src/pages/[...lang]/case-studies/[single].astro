---
import CallToAction from "@/components/sections/CallToAction.astro";
import Base from "@/layouts/Base.astro";
import LayoutWrapper from "@/components/LayoutWrapper.astro";
import resolveImageUrl from "@/lib/utils/resolveImageUrl";
import fetchApi from "@/lib/utils/fetchApi";
import type { CaseStudy } from "@/types";

export async function getStaticPaths() {
  const caseStudies = await fetchApi<CaseStudy[]>({ endpoint: 'case-studies', wrappedByKey: 'data' });
  return caseStudies.map((item) => ({
    params: { single: item.slug },
  }));
}

const { single } = Astro.params as { single: string };

const caseStudyData = await fetchApi<CaseStudy>({
  endpoint: `case-studies`,
  query: {
    'filters[slug][$eq]': single,
    'populate[coverImage][populate]': true,
    'populate[author][populate]': 'avatar',
    'populate[categories][populate]': true,
  },
  wrappedByKey: 'data',
  wrappedByList: true,
});

if (!caseStudyData) {
  throw new Error(`Case Study not found for slug: ${single}`);
}

const caseStudy = {
  id: caseStudyData.id,
  title: caseStudyData.title,
  slug: caseStudyData.slug,
  date: new Date(caseStudyData.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
  author: caseStudyData.author?.name,
  authorObject: {
    title: caseStudyData.author?.name || '',
    image: caseStudyData.author?.avatar?.url ? resolveImageUrl(caseStudyData.author.avatar) : '',
    role: caseStudyData.author?.role || '',
  },
  categories: caseStudyData.categories?.map((cat: { name: string }) => cat.name) || [],
  excerpt: caseStudyData.excerpt,
  image: resolveImageUrl(caseStudyData.coverImage),
  content: caseStudyData.content || null,
};

---

<Base {...caseStudy}>
  <LayoutWrapper
    sidebar={{ enable: false, sticky: true }}
    content={caseStudy}
    boxShadow={false}
  />
  <CallToAction />
</Base> 